{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://power-monitor.local/schemas/agent-heartbeat-v2.schema.json",
  "title": "Power Monitor headless agent heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "device_id",
    "boot_id",
    "firmware_version",
    "build_hash",
    "uptime_ms",
    "reset_reason",
    "wifi",
    "pzem",
    "sd",
    "sequences",
    "reset_projection",
    "capabilities",
    "configuration_revision",
    "reset_generation",
    "reset_operation",
    "resources",
    "task_stack_margins",
    "ota",
    "time_trusted"
  ],
  "properties": {
    "protocol": {"const": "pm-agent/2.0.0"},
    "device_id": {"type": "string", "format": "uuid"},
    "boot_id": {"type": "string", "format": "uuid"},
    "firmware_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "build_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uptime_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "reset_reason": {"type": "string", "minLength": 1, "maxLength": 64},
    "wifi": {"type": "object"},
    "latest": {"type": ["object", "null"]},
    "pzem": {"type": "object"},
    "sd": {"type": "object"},
    "sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oldest_stored_sequence", "newest_stored_sequence", "newest_syncable_sequence", "server_acknowledgement", "maximum_seen_sequence", "sequence_floor", "next_sequence"],
      "properties": {
        "oldest_stored_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "newest_stored_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "newest_syncable_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "server_acknowledgement": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "maximum_seen_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "sequence_floor": {"type": "integer", "minimum": 0, "maximum": 9223372036854775805},
        "next_sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775806}
      }
    },
    "reset_projection": {"type": "object"},
    "capabilities": {"type": "object"},
    "configuration_revision": {"type": "integer", "minimum": 0},
    "reset_generation": {"type": "integer", "minimum": 0},
    "reset_operation": {"type": "object"},
    "resources": {"type": "object"},
    "task_stack_margins": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "last_command_result": {"type": ["object", "null"]},
    "ota": {"type": "object"},
    "time_trusted": {"type": "boolean"}
  }
}
