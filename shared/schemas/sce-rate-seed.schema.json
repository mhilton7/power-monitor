{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://power-monitor.local/schemas/sce-rate-seed.schema.json",
  "title": "Power Monitor effective-dated rate seed",
  "type": "object",
  "required": ["schema_version", "plans"],
  "properties": {
    "schema_version": {"const": "rate-seed/1.0.0"},
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "effective_from", "timezone", "periods"],
        "properties": {
          "code": {"type": "string"},
          "effective_from": {"type": "string", "format": "date"},
          "timezone": {"type": "string"},
          "periods": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

