# Copy to .env and replace every CHANGE_ME value. Never commit .env.
POWER_MONITOR_VERSION=1.0.0
RELEASE_COMMIT=development
DATABASE_URL=postgresql+asyncpg://power_monitor:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/power_monitor
POSTGRES_DB=power_monitor
POSTGRES_USER=power_monitor
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
APP_MASTER_KEY=CHANGE_ME_FERNET_KEY
SESSION_PEPPER=CHANGE_ME_32_BYTE_RANDOM_VALUE
BOOTSTRAP_SECRET=CHANGE_ME_ONE_TIME_BOOTSTRAP_SECRET
PUBLIC_ORIGIN=https://power-monitor.example.com
COOKIE_SECURE=true
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY_FILE=
CADDY_SITE_ADDRESS=power-monitor.example.com
CADDY_TLS_MODE=public
SMTP_URL=
WEBHOOK_ALLOWED_HOSTS=
POLL_PUBLIC_ADDRESSES=false
RATE_SYNC_ENABLED=true
RATE_SYNC_CRON=15 3 * * 0
RATE_SYNC_TIMEZONE=America/Los_Angeles
RATE_SYNC_JITTER_MINUTES=20
RATE_SYNC_POLICY=manual_review
RATE_SYNC_MAX_SOURCE_BYTES=10485760
RATE_SYNC_CONNECT_TIMEOUT_SECONDS=10
RATE_SYNC_READ_TIMEOUT_SECONDS=30
RATE_SYNC_TOTAL_TIMEOUT_SECONDS=45
RATE_SYNC_MAX_REDIRECTS=3
RATE_SYNC_MAX_RETRIES=3
RATE_SYNC_ALLOWED_HOSTS=www.sce.com,sce.com
RATE_SYNC_ARTIFACT_PATH=/app/data/rate-source-artifacts
RATE_SYNC_AUTO_MAX_PERCENT_CHANGE=25
RATE_SYNC_RETROACTIVE_AUTO_DAYS=0
UTILITY_BILL_ARTIFACT_PATH=/app/data/rate-source-artifacts/utility-bills
UTILITY_BILL_MAX_BYTES=20971520
UTILITY_BILL_MAX_PAGES=40
UTILITY_BILL_OCR_TIMEOUT_SECONDS=60
UTILITY_BILL_OCR_DPI=200
UTILITY_BILL_OCR_MAX_MEMORY_MB=768
